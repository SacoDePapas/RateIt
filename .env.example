DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/rateit?sslmode=require"

# Safe to expose in the Vite browser bundle. Get this from Clerk API Keys.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_your_publishable_key"

# Server-only Clerk verification settings. Never prefix these with VITE_.
CLERK_FRONTEND_API_URL="https://your-instance.clerk.accounts.dev"
CLERK_JWKS_URL="https://your-instance.clerk.accounts.dev/.well-known/jwks.json"
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_PUBLIC_KEY\n-----END PUBLIC KEY-----"
CLERK_AUTHORIZED_PARTIES="http://localhost:5173,https://your-project.vercel.app"
